# Copiar a .env (cp .env.example .env). El .env no se commitea.

# URL base de la API del back (obligatoria). Se lee solo en src/config/entorno.ts.
VITE_API_URL=http://localhost:8000/api/v1

# Usar datos simulados en vez de la API: "true" o "false" (cualquier otro valor da error).
VITE_USAR_MOCKS=true

# Puerto del servidor de desarrollo de Vite. Lo lee vite.config.ts con loadEnv.
# Si se omite, Vite usa 5173.
PUERTO_DEV=5173
