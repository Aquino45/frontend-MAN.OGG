# Copiar a .env (cp .env.example .env). El .env no se commitea.

# URL base de la API del back (obligatoria). Se lee solo en src/config/entorno.ts.
VITE_API_URL=http://localhost:8000/api/v1

# Usar datos simulados en vez de la API: "true" o "false" (cualquier otro valor da error).
VITE_USAR_MOCKS=true

# URL del panel de administración (opcional). Debe ser una dirección http o https completa.
# Si se omite, el front no enlaza con el panel.
# VITE_URL_PANEL=http://localhost:8000/panel-censo/

# Puerto del servidor de desarrollo de Vite. Lo lee vite.config.ts con loadEnv.
# Si se omite, Vite usa 5173.
PUERTO_DEV=5173

# Ruta al contrato OpenAPI del back, relativa a este repo. La usa `npm run contrato:tipos`
# (scripts/generar-tipos.mjs) para generar src/api/schema.d.ts. No llega al navegador.
CONTRATO_RUTA=../censo-arboreo-backend/contrato/openapi.yaml

# Mapa real del sitio público: vista «Calles» (siempre) y «Satélite» (solo con clave de Esri).
# Clave de ArcGIS Location Platform con el permiso de mapas base (opcional). Sin ella no hay
# vista «Satélite». Es secreta: va solo en el .env, nunca en git.
# VITE_ESRI_CLAVE=
# Teselas del satélite y de «Calles» (opcionales). Si se omiten, se usan las de
# src/config/satelite.ts: el World Imagery de Esri y las públicas de OpenStreetMap.
# VITE_ESRI_URL_TESELAS=
# VITE_URL_CALLES=
